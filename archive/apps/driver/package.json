    "expo": "57.0.16",
    "expo-build-properties": "57.0.14",
    "expo-camera": "~57.0.4",
    "expo-crypto": "57.0.2",
    "expo-dev-client": "57.0.15",
    "expo-file-system": "~57.0.6",
    "expo-location": "57.0.13",
    "expo-network": "57.0.1",
    "expo-notifications": "~57.0.15",
    "expo-router": "57.0.16",
    "expo-screen-capture": "57.0.2",
    "expo-secure-store": "57.0.1",
    "expo-sqlite": "57.0.1",
    "expo-task-manager": "57.0.13",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
