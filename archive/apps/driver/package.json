    "react-test-renderer": "19.2.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-build-properties",
        "expo-dev-client",
        "expo-location",
        "expo-router",
        "expo-secure-store",
        "expo-sqlite",
        "expo-task-manager",
        "react-native",
        "jest-expo"
