{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kavaroutes.local/schemas/workload-scenario.schema.json",
  "title": "KavaRoutes synthetic workload scenario",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "seed", "profileIds", "duration", "phases", "fixtures", "externalServices"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "seed": { "type": "string", "minLength": 1 },
    "profileIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "duration": { "$ref": "#/$defs/duration" },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "duration", "loadMultipliers"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "duration": { "$ref": "#/$defs/duration" },
          "loadMultipliers": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "number", "minimum": 0 } }
        }
      }
    },
    "parameters": { "type": "object" },
    "fixtures": {
      "type": "object",
      "required": ["actors", "references"],
      "additionalProperties": false,
      "properties": {
        "actors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "kind", "tenantOrdinal", "entityOrdinal"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["tenant", "user", "trip", "vehicle", "location_sample", "command", "event"] },
              "tenantOrdinal": { "type": "integer", "minimum": 0 },
              "entityOrdinal": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "tenantOrdinal"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 },
              "tenantOrdinal": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "externalServices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "mode", "assumption", "documented"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "minLength": 1 },
          "assumption": { "type": "string", "minLength": 1 },
          "documented": { "const": true }
        }
      }
    }
  },
  "$defs": {
    "duration": {
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["second", "minute", "hour"] }
      }
    }
  }
}
