{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kavaroutes.local/schemas/privacy-assurance.schema.json",
  "title": "KavaRoutes synthetic privacy and HIPAA assurance registry",
  "type": "object",
  "required": ["schemaVersion", "registryVersion", "synthetic", "legalDisclaimer", "applicability", "controls", "evidence", "risks", "vendors", "evaluations", "incidents", "contingency", "workforce", "assurances"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "registryVersion": { "type": "string", "minLength": 1 },
    "synthetic": { "const": true },
    "legalDisclaimer": { "type": "string", "minLength": 1 },
    "applicability": { "type": "array", "minItems": 1 },
    "controls": { "type": "array", "minItems": 1 },
    "evidence": { "type": "array", "minItems": 1 },
    "risks": { "type": "array", "minItems": 1 },
    "vendors": { "type": "array", "minItems": 1 },
    "evaluations": { "type": "array", "minItems": 1 },
    "incidents": { "type": "array", "minItems": 1 },
    "contingency": { "type": "array", "minItems": 1 },
    "workforce": { "type": "object" },
    "assurances": { "type": "array", "minItems": 4 }
  }
}
