# Runtime configuration, read by the site server. These are not VITE variables.
KR_SITE_ORIGIN=http://127.0.0.1:4313
KR_SITE_PORT=58110
KR_SITE_DATABASE=/tmp/kavaroutes-site/accounts.sqlite
# Firebase browser configuration is public; never put service-account keys here.
KR_SITE_FIREBASE_PROJECT_ID=kavaroutes
KR_SITE_FIREBASE_API_KEY=
KR_SITE_FIREBASE_AUTH_DOMAIN=kavaroutes.firebaseapp.com
# Dedicated Identity Platform tenant for BUSINESS accounts, not driver accounts.
KR_SITE_FIREBASE_TENANT_ID=
# Use Application Default Credentials on the host for the Admin SDK.
# Stripe is deliberately not configured or called in this version.
