{
  "expo": {
    "name": "KavaRoutes Driver",
    "slug": "kavaroutes-driver",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "kavaroutes-driver",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kavaroutes.driver",
      "infoPlist": {"UIFileSharingEnabled": false, "LSSupportsOpeningDocumentsInPlace": false}
    },
    "android": {
      "package": "com.kavaroutes.driver",
      "allowBackup": false,
      "permissions": ["android.permission.POST_NOTIFICATIONS"],
      "blockedPermissions": ["android.permission.READ_MEDIA_IMAGES", "android.permission.RECORD_AUDIO", "android.permission.READ_EXTERNAL_STORAGE"]
    },
    "plugins": [
      ["expo-sqlite", {"enableFTS": false, "useSQLCipher": true}],
      ["expo-secure-store", {"configureAndroidBackup": false}],
      ["expo-location", {
        "locationWhenInUsePermission": "KavaRoutes Driver uses your location to show Dispatch where your assigned shift is.",
        "locationAlwaysAndWhenInUsePermission": "KavaRoutes Driver continues sharing your location during an active shift, including while Google Maps is open.",
        "isIosBackgroundLocationEnabled": true,
        "isAndroidBackgroundLocationEnabled": true,
        "isAndroidForegroundServiceEnabled": true
      }]
    ]
  }
}
