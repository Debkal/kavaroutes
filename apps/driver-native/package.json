{
  "name": "@kavaroutes/driver-native",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo/AppEntry",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bundle:android": "expo export --platform android --output-dir dist/android",
    "bundle:ios": "expo export --platform ios --output-dir dist/ios",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "expo": "57.0.16",
    "expo-crypto": "57.0.2",
    "expo-location": "57.0.13",
    "expo-secure-store": "57.0.1",
    "expo-sqlite": "57.0.1",
    "expo-task-manager": "57.0.13",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18"
  }
}
