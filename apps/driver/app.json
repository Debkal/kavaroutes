{
  "expo": {
    "name": "KavaRoutes Driver Test",
    "slug": "kavaroutes-driver-local",
    "version": "0.0.0-wp010",
    "runtimeVersion": "0.0.0-wp010",
    "scheme": "kavaroutes-driver-local",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kavaroutes.driver.synthetic",
      "infoPlist": { "UIFileSharingEnabled": false, "LSSupportsOpeningDocumentsInPlace": false }
    },
    "android": {
      "package": "com.kavaroutes.driver.synthetic",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      ["expo-build-properties", { "android": { "compileSdkVersion": 36, "targetSdkVersion": 36, "minSdkVersion": 29 }, "ios": { "deploymentTarget": "16.4" } }],
      ["expo-sqlite", { "enableFTS": false, "useSQLCipher": true }],
      ["expo-secure-store", { "configureAndroidBackup": false, "faceIDPermission": "KavaRoutes WP010 does not use Face ID." }],
      ["expo-camera", { "cameraPermission": "Allow KavaRoutes Driver to photograph a synthetic vehicle defect. Keep people, paperwork, labels, screens, and private information out of frame.", "recordAudioAndroid": false, "barcodeScannerEnabled": false }],
      ["expo-location", {
        "locationWhenInUsePermission": "Allow KavaRoutes Driver to use your location while you test a shift.",
        "locationAlwaysAndWhenInUsePermission": "Allow KavaRoutes Driver to use your location during a test shift, even when the app is not on screen.",
        "isIosBackgroundLocationEnabled": true,
        "isAndroidBackgroundLocationEnabled": true,
        "isAndroidForegroundServiceEnabled": true
      }]
    ],
    "experiments": { "typedRoutes": false },
    "extra": { "environment": "synthetic-local", "otaEnabled": false, "publicListener": false }
  }
}
