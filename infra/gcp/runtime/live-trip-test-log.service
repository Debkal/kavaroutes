[Unit]
Description=KavaRoutes business-scoped trip diagnostic logger
After=docker.service kavaroutes-site.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/kavaroutes-live-test/live-trip-test-log.py --all
Restart=on-failure
RestartSec=10
StateDirectory=kavaroutes-site
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kavaroutes-site /var/lib/kavaroutes-admin

[Install]
WantedBy=multi-user.target
