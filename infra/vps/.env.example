# Non-secret Compose settings only. Copy to .env.vps (ignored by Git).
KR_BUILD_ID=release-20261001
KR_SECRETS_DIRECTORY=/opt/kavaroutes/secrets
KR_GOOGLE_DIRECTORY=/opt/kavaroutes/google
KR_DRIVER_ACCESS_DIRECTORY=/opt/kavaroutes/driver-access
KR_SITE_DIRECTORY=/var/lib/kavaroutes-site
KR_REGISTRATIONS_DIRECTORY=/var/lib/kavaroutes-registrations
KR_ADMIN_DIRECTORY=/var/lib/kavaroutes-admin
# Existing cloud Compose volume. For a NEW host choose/create a new volume.
KR_POSTGRES_VOLUME=kavaroutes-cloud_database
KR_APP_UID=1000
KR_APP_GID=1000
KR_SITE_UID=1000
KR_ADMIN_UID=1000
KR_SHARED_GID=1000
